{
    "name": "@agentsig/structured-fields",
    "version": "0.0.0",
    "description": "Lossless RFC 9651 Structured Fields parsing and serialization.",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=20"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/agentsig-dev/agentsig.git",
        "directory": "packages/structured-fields"
    },
    "homepage": "https://github.com/agentsig-dev/agentsig/tree/main/packages/structured-fields#readme",
    "bugs": {
        "url": "https://github.com/agentsig-dev/agentsig/issues"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts --clean --target node20",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    }
}