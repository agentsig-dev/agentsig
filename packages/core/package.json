{
    "name": "@agentsig/core",
    "version": "0.2.0",
    "description": "Framework-independent HTTP Message Signatures with Ed25519 for Node.js.",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=20"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/agentsig-dev/agentsig.git",
        "directory": "packages/core"
    },
    "homepage": "https://github.com/agentsig-dev/agentsig/tree/main/packages/core#readme",
    "bugs": {
        "url": "https://github.com/agentsig-dev/agentsig/issues"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./profiles": {
            "import": {
                "types": "./dist/profiles.d.ts",
                "default": "./dist/profiles.js"
            },
            "require": {
                "types": "./dist/profiles.d.cts",
                "default": "./dist/profiles.cjs"
            }
        },
        "./discovery": {
            "import": {
                "types": "./dist/discovery.d.ts",
                "default": "./dist/discovery.js"
            },
            "require": {
                "types": "./dist/discovery.d.cts",
                "default": "./dist/discovery.cjs"
            }
        },
        "./http": {
            "import": {
                "types": "./dist/http.d.ts",
                "default": "./dist/http.js"
            },
            "require": {
                "types": "./dist/http.d.cts",
                "default": "./dist/http.cjs"
            }
        },
        "./redis": {
            "import": {
                "types": "./dist/redis.d.ts",
                "default": "./dist/redis.js"
            },
            "require": {
                "types": "./dist/redis.d.cts",
                "default": "./dist/redis.cjs"
            }
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup src/index.ts src/profiles.ts src/discovery.ts src/redis.ts src/http.ts --format esm,cjs --splitting --dts --clean --target node20",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run test"
    },
    "dependencies": {
        "@agentsig/structured-fields": "0.1.1"
    }
}