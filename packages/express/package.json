{
    "name": "@agentsig/express",
    "version": "0.0.0",
    "description": "Thin Node HTTP/1.1 Express integration for agentsig.",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=20"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/agentsig-dev/agentsig.git",
        "directory": "packages/express"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts --clean --target node20",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run test"
    },
    "dependencies": {
        "@agentsig/core": "workspace:*"
    },
    "peerDependencies": {
        "express": "4.22.3 || 5.2.1"
    },
    "devDependencies": {
        "@types/express": "5.0.6",
        "express": "5.2.1",
        "express4": "npm:express@4.22.3"
    }
}