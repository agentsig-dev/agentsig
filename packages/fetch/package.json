{
    "name": "@agentsig/fetch",
    "version": "0.2.0",
    "description": "Explicit signed Fetch requests for agentsig on Node.js.",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=20"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/agentsig-dev/agentsig.git",
        "directory": "packages/fetch"
    },
    "homepage": "https://github.com/agentsig-dev/agentsig/tree/main/packages/fetch#readme",
    "bugs": {
        "url": "https://github.com/agentsig-dev/agentsig/issues"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts --clean --target node20",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run test"
    },
    "dependencies": {
        "@agentsig/core": "0.2.0"
    }
}