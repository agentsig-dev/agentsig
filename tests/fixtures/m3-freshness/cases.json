{
    "formatVersion": 1,
    "authoredOn": "2026-09-19",
    "status": "pre-implementation-expectations",
    "scope": "Conservative reusable freshness only; not current-invocation authentication or a cache implementation",
    "decisionBasis": "Approved bounded freshness and fail-closed implementation discretion; not new maintainer approvals",
    "defaults": {
        "fallbackSeconds": 60,
        "maximumLifetimeSeconds": 300,
        "requestStartedMonotonicMs": 1000,
        "responseReceivedMonotonicMs": 1000,
        "responseReceivedWallMs": 784111777000
    },
    "rules": {
        "age": "corrected initial age = max(max(0, response wall time - Date), Age + monotonic response delay)",
        "remaining": "max(0, min(explicit lifetime or fallback, local maximum) - corrected initial age - monotonic residence)",
        "boundary": "Fresh only while elapsed residence is strictly less than remaining lifetime at receipt",
        "invalidMetadata": "No reusable freshness; never replace invalid explicit information with fallback",
        "duplicates": "Repeated max-age, s-maxage, Date, Age or Expires is ambiguous even if equal: no reusable freshness",
        "sharedRestrictions": "Use the shorter of max-age and s-maxage when both exist; private and no-store prohibit persistence",
        "dateParsing": "Initial local policy accepts canonical IMF-fixdate only, with matching weekday and valid calendar; obsolete or repaired dates do not grant reuse",
        "expires": "Use Expires minus Date only when max-age and s-maxage are absent; without Date decline reusable freshness",
        "revalidation": "no-cache grants no reuse; must-revalidate does not prohibit otherwise fresh reuse; stale extensions never grant stale acceptance",
        "clock": "Invalid, regressing or non-finite timing samples grant no reusable freshness",
        "noStore": "No persistent key set; a successful validated replacement must still invalidate older evidence",
        "unknownExtensions": "Well-formed unknown directives do not grant freshness or override restrictions"
    },
    "cases": [
