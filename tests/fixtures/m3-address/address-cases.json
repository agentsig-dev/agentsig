{
    "formatVersion": 1,
    "status": "pre-implementation-expectations",
    "authoredOn": "2026-09-19",
    "policy": {
        "purpose": "Conservative destination admission for HTTPS directory discovery, not a general Internet routing classifier",
        "specialPurpose": "Reject every prefix in the two pinned IANA special-purpose registries, including globally reachable special-purpose services and nested exceptions",
        "ipv4AdditionalExclusions": [
            "224.0.0.0/4"
        ],
        "ipv6AdmissionEnvelope": "2000::/3, minus all pinned special-purpose prefixes",
        "ipv6TransitionMechanisms": "Reject mapped, compatible, NAT64 well-known, Teredo and 6to4 forms; do not decode an embedded address and silently widen admission",
        "representation": "Accept unbracketed strict IP address text from trusted DNS resolution only; reject zone identifiers, surrounding whitespace, ports, CIDR notation and noncanonical IPv4 numeric spellings",
        "originRuleSeparate": "M2 origin grammar rejects all IP-literal origins, even when an address would otherwise pass destination classification",
        "mixedAnswers": "Reject the entire bounded DNS candidate set if any address is invalid or forbidden",
        "peerRule": "Compare the actual connected address numerically to the pinned destination; an OS-mapped representation of an already approved IPv4 peer is comparison-only, not a DNS admission exception",
        "limitations": [
            "This conservative policy can reject globally reachable special-purpose services; that restriction is intentional and must not be attributed to an IANA global=False flag.",
            "Passing classification does not prove an address is allocated, reachable, honest, or safe under deployment-local routing.",
            "Custom NAT64 prefixes, unusual routing and network-specific sensitive public destinations require deployment egress controls.",
            "No production option may disable the baseline exclusions in allowlist or open mode.",
            "The registry snapshots must be reviewed and updated explicitly; runtime requests never fetch classification rules."
        ]
    },
