    "clockContract": {
        "wallUnits": "milliseconds since Unix epoch",
        "monotonicUnits": "milliseconds from an arbitrary monotonic origin",
        "effectiveTime": "referenceWallMs + (monotonicMs - referenceMonotonicMs)",
        "signatureTime": "floor(effectiveTime / 1000)",
        "maxClockDriftSeconds": 30,
        "driftThresholdIndependentOfSignatureSkew": true,
        "thresholdComparison": "absolute drift strictly greater than threshold is unhealthy",
        "automaticRebase": false,
        "onUnhealthy": {
            "expectedCode": "clock-unavailable",
            "consumeReplay": false,
            "expireReplayEntries": false
        },
        "wallDriftRecovery": "Return within threshold against the original reference; no rebase or store clear.",
        "monotonicRegressionRecovery": "Explicit operator reset is required.",
        "events": "Health entry/exit transitions; repeated samples in the same health state do not repeat transition events.",
        "eventPayloadExcludes": [
            "nonce",
            "request headers",
            "private key material"
        ],
        "operatorReset": {
            "apiName": "resetClockReference",
            "automatic": false,
            "freshWallAndMonotonicReference": true,
            "clearInMemoryReplayEntries": true,
            "clearPerKeyQuotaCounters": true,
            "invalidateInFlightVerificationEpochs": true,
            "oldEpochMayReturnVerified": false,
            "oldEpochExpectedCode": "clock-unavailable",
            "emitExplicitResetEvent": true,
            "replayProtectionDiscontinuity": true,
            "previouslyAcceptedStillValidSignatureMayBeAcceptedAgain": true
        }
    },
